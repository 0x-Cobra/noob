# Copy to .env. Loaded at startup; existing environment variables take precedence.
FINNHUB_API_KEY=            # https://finnhub.io  (free tier is enough for paper)
POLYGON_API_KEY=            # only if reference.provider = polygon
TELEGRAM_BOT_TOKEN=         # from @BotFather
TELEGRAM_CHAT_ID=           # your chat id (message the bot, then https://api.telegram.org/bot<token>/getUpdates)
APEBOT_RPC_URL=             # optional: dedicated RPC (Alchemy / QuickNode) overriding chain.rpc_url
APEBOT_PRIVATE_KEY=         # ONLY for live. A dedicated hot wallet holding just the inventory you want to trade.
